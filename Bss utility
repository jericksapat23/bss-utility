--==================================================
-- LIVE CRAFT STATUS
--==================================================

local function updateBlenderMaterials()
    clearMaterialList()

    local count, errorMessage =
        validatePositiveInteger(
            BlenderCountBox.Text,
            MAX_BLENDER_COUNT
        )

    if not count then
        BlenderStatus.Text =
            "Status: " .. errorMessage

        BlenderStatus.TextColor3 =
            Color3.fromRGB(255, 100, 100)

        return {
            Allowed = false,
        }
    end

    local recipe =
        getRecipe(selectedRecipe)

    if not recipe then
        BlenderStatus.Text =
            "Status: Recipe data unavailable."

        BlenderStatus.TextColor3 =
            Color3.fromRGB(255, 100, 100)

        return {
            Allowed = false,
        }
    end

    local requirements =
        calculateRecipeRequirements(
            selectedRecipe,
            count
        )

    if not requirements then
        BlenderStatus.Text =
            "Status: Unable to calculate recipe."

        BlenderStatus.TextColor3 =
            Color3.fromRGB(255, 100, 100)

        return {
            Allowed = false,
        }
    end

    local result =
        checkCanCraft(
            selectedRecipe,
            count
        )

    local keys = {}

    for itemType in pairs(requirements) do
        table.insert(keys, itemType)
    end

    table.sort(keys)

    for _, itemType in ipairs(keys) do
        local required = requirements[itemType]
        local have = getInventoryAmount(itemType)

        local missing

        if have == nil then
            missing = nil
        else
            missing = math.max(
                required - have,
                0
            )
        end

        addMaterialRow(
            itemType,
            required,
            have,
            missing
        )
    end

    if #result.Errors > 0 then
        BlenderStatus.Text =
            "Status: " ..
            table.concat(
                result.Errors,
                " "
            )

        BlenderStatus.TextColor3 =
            Color3.fromRGB(255, 100, 100)

    elseif result.Unavailable and
        #result.Unavailable > 0 then

        BlenderStatus.Text =
            "Status: Cannot verify inventory."

        BlenderStatus.TextColor3 =
            Color3.fromRGB(255, 180, 80)

    elseif #result.Missing > 0 then
        local messages = {}

        for _, missing in ipairs(result.Missing) do
            table.insert(
                messages,
                missing.Type
                    .. " x"
                    .. formatNumber(
                        missing.Missing
                    )
            )
        end

        BlenderStatus.Text =
            "Status: Missing materials: "
            .. table.concat(
                messages,
                ", "
            )

        BlenderStatus.TextColor3 =
            Color3.fromRGB(255, 100, 100)

    else
        BlenderStatus.Text =
            "Status: ✓ Ready to craft."

        BlenderStatus.TextColor3 =
            Color3.fromRGB(105, 240, 135)
    end

    return result
end

