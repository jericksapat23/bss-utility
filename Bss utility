local function formatNumber(value)
    if typeof(value) ~= "number" then
        return "N/A"
    end

    if value ~= value then
        return "N/A"
    end

    if value == math.huge then
        return "∞"
    end

    if value == -math.huge then
        return "-∞"
    end

    local negative = value < 0
    value = math.abs(value)

    local result = tostring(math.floor(value))

    while true do
        local replacement, count = result:gsub(
            "^(-?%d+)(%d%d%d)",
            "%1,%2"
        )

        result = replacement

        if count == 0 then
            break
        end
    end

    if negative then
        result = "-" .. result
    end

    return result
end

local function validatePositiveInteger(text, maximum)
    text = tostring(text or ""):gsub("%s+", "")

    if text == "" then
        return nil, "Enter a positive integer."
    end

    if not text:match("^%d+$") then
        return nil, "Enter a positive integer."
    end

    local number = tonumber(text)

    if not number then
        return nil, "Invalid number."
    end

    if number <= 0 then
        return nil, "Number must be greater than 0."
    end

    if number ~= math.floor(number) then
        return nil, "Number must be an integer."
    end

    if maximum and number > maximum then
        return nil, "Number exceeds the limit."
    end

    return number
end

local function safeCall(callback)
    local success, result = pcall(callback)

    if success then
        return true, result
    end

    return false, nil
end

