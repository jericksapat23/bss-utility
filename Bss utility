--==================================================
-- SPEED UP COST CALCULATION
--==================================================

local function getCurrentSpeedUpCost()
    local stats = getCachedStats()

    if not stats then
        return nil
    end

    local blenderState = stats.BlenderState

    if type(blenderState) ~= "table" then
        return nil
    end

    local recipeName = blenderState.Recipe
    local count = tonumber(blenderState.Count)

    if type(recipeName) ~= "string" then
        return nil
    end

    if not count or count <= 0 then
        return nil
    end

    local recipe = getRecipe(recipeName)

    if not recipe then
        return nil
    end

    local autoCompletePerTicket =
        tonumber(
            recipe.AutoCompletePerTicket
        )

    local recipeTime =
        tonumber(recipe.Time)

    if not autoCompletePerTicket
        or autoCompletePerTicket <= 0
        or not recipeTime
        or recipeTime <= 0 then

        return nil
    end

    local playtimeAtLoad =
        tonumber(
            stats.PlaytimeAtLoad
        )

    local loadTime =
        tonumber(
            stats.LoadTime
        )

    local offlineProgressTime =
        tonumber(
            stats.OfflineProgressTime
        ) or 0

    if not playtimeAtLoad
        or not loadTime then

        return nil
    end

    local now = os.time()

    local elapsed =
        playtimeAtLoad
        + (now - loadTime)
        + offlineProgressTime
        - (tonumber(
            blenderState.StartTime
        ) or 0)

    local totalTime =
        count * recipeTime

    if totalTime <= 0 then
        return nil
    end

    local progress =
        math.clamp(
            elapsed / totalTime,
            0,
            1
        )

    local completed =
        math.floor(
            progress * count
        )

    local cost =
        math.ceil(
            (
                count
                - completed
            )
            / autoCompletePerTicket
        )

    if cost < 0 then
        cost = 0
    end

    return cost
end

local function updateSpeedUpDisplay()
    local currentTickets =
        getTickets()

    local speedUpCost =
        getCurrentSpeedUpCost()

    if currentTickets == nil then
        CurrentTicketsLabel.Text =
            "🎟️ Current Tickets: N/A"
    else
        CurrentTicketsLabel.Text =
            "🎟️ Current Tickets: "
            .. formatNumber(currentTickets)
    end

    if speedUpCost == nil then
        SpeedCostLabel.Text =
            "🎟️ Speed Up Cost: N/A"

        TicketsRemainingLabel.Text =
            "🎟️ After Speed Up: N/A"

        return
    end

    SpeedCostLabel.Text =
        "🎟️ Speed Up Cost: "
        .. formatNumber(speedUpCost)

    if currentTickets == nil then
        TicketsRemainingLabel.Text =
            "🎟️ After Speed Up: N/A"
    else
        TicketsRemainingLabel.Text =
            "🎟️ After Speed Up: "
            .. formatNumber(
                currentTickets
                - speedUpCost
            )
    end
end

