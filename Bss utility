local function addCalculatorRow(
    itemType,
    required,
    have,
    missing
)
    local row =
        Instance.new("TextLabel")

    row.Size =
        UDim2.new(1, -8, 0, 29)

    row.BackgroundColor3 =
        Color3.fromRGB(31, 35, 44)

    row.BorderSizePixel = 0

    row.TextColor3 =
        Color3.fromRGB(225, 225, 230)

    row.TextSize = 11

    row.Font =
        Enum.Font.Gotham

    row.TextXAlignment =
        Enum.TextXAlignment.Left

    row.Text =
        string.format(
            "%-18s Required: %-10s Have: %-10s Missing: %s",
            itemType,
            formatNumber(required),
            have == nil
                and "N/A"
                or formatNumber(have),
            missing == nil
                and "N/A"
                or formatNumber(missing)
        )

    row.Parent =
        CalculatorList

    addCorner(row, 7)
    addStroke(row, Color3.fromRGB(53, 58, 70), 0.45, 1)

    local padding =
        Instance.new("UIPadding")

    padding.PaddingLeft =
        UDim.new(0, 8)

    padding.Parent =
        row
end

function updateCalculator()
    clearCalculator()

    local count, errorMessage =
        validatePositiveInteger(
            CalculatorCountBox.Text,
            MAX_BLENDER_COUNT
        )

    if not count then
        addCalculatorRow(
            "ERROR",
            0,
            errorMessage,
            nil
        )
        return
    end

    local requirements =
        calculateRecipeRequirements(
            selectedRecipe,
            count
        )

    if not requirements then
        addCalculatorRow(
            "ERROR",
            0,
            "Recipe unavailable",
            nil
        )
        return
    end

    local keys = {}

    for itemType in pairs(requirements) do
        table.insert(
            keys,
            itemType
        )
    end

    table.sort(keys)

    for _, itemType in ipairs(keys) do
        local required =
            requirements[itemType]

        local have =
            getInventoryAmount(itemType)

        local missing

        if have ~= nil then
            missing =
                math.max(
                    required - have,
                    0
                )
        end

        addCalculatorRow(
            itemType,
            required,
            have,
            missing
        )
    end
end

CalculatorCountBox:GetPropertyChangedSignal(
    "Text"
):Connect(updateCalculator)

