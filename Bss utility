--==================================================
-- RECIPE DATA
--==================================================

local function getRecipe(recipeName)
    local success, recipe = pcall(function()
        return BlenderRecipes.Get(recipeName)
    end)

    if success and type(recipe) == "table" then
        return recipe
    end

    return nil
end

local function calculateRecipeRequirements(
    recipeName,
    count
)
    local recipe = getRecipe(recipeName)

    if not recipe then
        return nil, "Recipe data unavailable."
    end

    if type(recipe.Ingredients) ~= "table" then
        return nil, "Recipe ingredients unavailable."
    end

    local requirements = {}

    for _, ingredient in ipairs(recipe.Ingredients) do
        if type(ingredient) ~= "table" then
            return nil, "Invalid ingredient data."
        end

        local itemType = ingredient.Type
        local amount = tonumber(ingredient.Amount)

        if type(itemType) ~= "string" then
            return nil, "Invalid ingredient type."
        end

        if not amount or amount < 0 then
            return nil, "Invalid ingredient amount."
        end

        local total = amount * count

        if total > MAX_AMOUNT * MAX_BLENDER_COUNT then
            return nil, "Calculated requirement is too large."
        end

        requirements[itemType] =
            (requirements[itemType] or 0) + total
    end

    return requirements
end

--==================================================
-- READ-ONLY CACHE
--==================================================

local function getCachedStats()
    local success, stats = safeCall(function()
        return ClientStatCache:Get()
    end)

    if success and type(stats) == "table" then
        latestStats = stats
        return stats
    end

    return latestStats
end

local function getHoney()
    local stats = getCachedStats()

    if stats and type(stats.Honey) == "number" then
        return stats.Honey
    end

    return nil
end

local function getInventoryAmount(itemType)
    local stats = getCachedStats()

    if not stats then
        return nil
    end

    if type(stats.Eggs) ~= "table" then
        return nil
    end

    local amount = stats.Eggs[itemType]

    if type(amount) == "number" then
        return amount
    end

    return nil
end

local function getTickets()
    return getInventoryAmount("Ticket")
end

local function getBeeCount()
    local stats = getCachedStats()

    if not stats then
        return nil
    end

    -- Bee data is stored as a player-stat collection in the game.
    -- Only return a value when an actual numeric count can be determined.
    if type(stats.Bees) == "table" then
        local count = 0

        for _, bee in pairs(stats.Bees) do
            if type(bee) == "table" then
                count += 1
            end
        end

        return count
    end

    if type(stats.BeeCount) == "number" then
        return stats.BeeCount
    end

    return nil
end

local function getHiveCapacity()
    local stats = getCachedStats()

    if not stats then
        return nil
    end

    if type(stats.UnlockedCells) == "number" then
        return stats.UnlockedCells
    end

    return nil
end

--==================================================
-- RECIPE REQUIREMENT CHECK
--==================================================

local function checkRecipeRequirements(recipe)
    if not recipe then
        return false, {
            {
                Message = "Recipe data unavailable.",
                Type = "Unavailable",
            },
        }
    end

    local recipeRequirements = recipe.Requirements

    if type(recipeRequirements) ~= "table" then
        return true, {}
    end

    if #recipeRequirements == 0 then
        return true, {}
    end

    local stats = getCachedStats()

    if not stats then
        return false, {
            {
                Message = "Cannot verify requirement.",
                Type = "Unavailable",
            },
        }
    end

    local results = {}

    for _, requirement in ipairs(recipeRequirements) do
        local success, satisfied = pcall(function()
            return StatTools.CheckReqs(
                stats,
                {
                    requirement,
                }
            )
        end)

        if not success then
            table.insert(results, {
                Message = "Cannot verify requirement.",
                Type = "Unavailable",
            })
        elseif not satisfied then
            local requirementType =
                tostring(requirement.Type or "Requirement")

            local requirementSet =
                requirement.Set

            local message

            if requirementSet then
                message =
                    requirementSet
                    .. " badge requirement not met."
            else
                message =
                    requirementType
                    .. " requirement not met."
            end

            table.insert(results, {
                Message = message,
                Type = "Missing",
            })
        end
    end

    return #results == 0, results
end

--==================================================
-- CRAFT CHECK
--==================================================

local function checkCanCraft(
    recipeName,
    count
)
    local recipe = getRecipe(recipeName)

    if not recipe then
        return {
            Allowed = false,
            Missing = {},
            Errors = {
                "Recipe data unavailable.",
            },
        }
    end

    local requirements, requirementError =
        calculateRecipeRequirements(
            recipeName,
            count
        )

    if not requirements then
        return {
            Allowed = false,
            Missing = {},
            Errors = {
                requirementError,
            },
        }
    end

    local missing = {}
    local unavailable = {}

    for itemType, requiredAmount in pairs(requirements) do
        local have = getInventoryAmount(itemType)

        if have == nil then
            table.insert(unavailable, itemType)
        elseif have < requiredAmount then
            table.insert(missing, {
                Type = itemType,
                Required = requiredAmount,
                Have = have,
                Missing = requiredAmount - have,
            })
        end
    end

    if #unavailable > 0 then
        return {
            Allowed = false,
            Missing = missing,
            Unavailable = unavailable,
            Errors = {
                "Cannot verify inventory.",
            },
            Requirements = requirements,
        }
    end

    local requirementOkay, requirementResults =
        checkRecipeRequirements(recipe)

    if not requirementOkay then
        local errors = {}

        for _, result in ipairs(requirementResults) do
            table.insert(
                errors,
                result.Message
            )
        end

        return {
            Allowed = false,
            Missing = missing,
            Errors = errors,
            RequirementResults = requirementResults,
            Requirements = requirements,
        }
    end

    if #missing > 0 then
        return {
            Allowed = false,
            Missing = missing,
            Errors = {},
            RequirementResults = requirementResults,
            Requirements = requirements,
        }
    end

    return {
        Allowed = true,
        Missing = {},
        Errors = {},
        RequirementResults = requirementResults,
        Requirements = requirements,
    }
end

