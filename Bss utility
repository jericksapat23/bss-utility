local function canSendRequest()
    if requestInProgress then
        setStatus(
            "Another request is still running.",
            "warning"
        )
        return false
    end

    local elapsed = os.clock() - lastRequestTime

    if elapsed < REQUEST_COOLDOWN then
        setStatus(
            string.format(
                "Please wait %.1f seconds.",
                REQUEST_COOLDOWN - elapsed
            ),
            "warning"
        )
        return false
    end

    return true
end

--==================================================
-- ITEM PURCHASE
--==================================================

local function purchaseItem(
    itemType,
    amount,
    displayName
)
    if not canSendRequest() then
        return
    end

    requestInProgress = true
    lastRequestTime = os.clock()

    setStatus(
        "Sending " .. displayName .. "...",
        "warning"
    )

    local success, result = pcall(function()
        return ItemPackageEvent:InvokeServer(
            "Purchase",
            {
                Type = itemType,
                Category = "Eggs",
                Amount = amount,
            }
        )
    end)

    requestInProgress = false

    if success then
        setStatus(
            displayName .. " request completed.",
            "success"
        )
    else
        setStatus(
            displayName .. " failed: " .. tostring(result),
            "error"
        )
        warn(
            "[BeeUtility] ItemPackageEvent:",
            result
        )
    end
end

--==================================================
-- BLENDER REMOTE
--==================================================

local function invokeBlender(
    command,
    data,
    successMessage
)
    if not canSendRequest() then
        return
    end

    requestInProgress = true
    lastRequestTime = os.clock()

    setStatus(
        "Sending Blender command...",
        "warning"
    )

    local success, result = pcall(function()
        if data then
            return BlenderCommand:InvokeServer(
                command,
                data
            )
        end

        return BlenderCommand:InvokeServer(
            command
        )
    end)

    requestInProgress = false

    if success then
        setStatus(
            successMessage,
            "success"
        )

        return true, result
    end

    setStatus(
        "Blender error: " .. tostring(result),
        "error"
    )

    warn(
        "[BeeUtility] BlenderCommand:",
        result
    )

    return false, nil
end

